APP_NAME=sticklearn-trainer
ENGINE_NAME=stick-ia

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_REQUESTS=train.requests
KAFKA_TOPIC_STATUS=train.status
KAFKA_GROUP_ID=trainer-worker-sticklearn
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

MONGO_URI=mongodb://mongo:27017
MONGO_DB=nlp

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123456
MODELS_BUCKET=nlp-models
MINIO_SECURE=false

N_ESTIMATORS=1000
CLASS_WEIGHT=balanced
RANDOM_STATE=42
N_JOBS=-1
VERBOSE=1

NGRAM_MIN_RANGE=1
NGRAM_MAX_RANGE=3
MAX_FEATURES=10000

LOG_LEVEL=INFO