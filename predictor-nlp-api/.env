# === App ===
APP_NAME=predict-nlp-api
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000

# === Mongo ===
# No compose, use o hostname do serviço (mongo)
MONGO_URI=mongodb://mongo:27017
MONGO_DB=nlp

# === MinIO ===
# No compose, use o hostname do serviço (minio)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123456
MINIO_SECURE=false
MINIO_DEFAULT_BUCKET=nlp-models

CACHE_MAX_ITEMS=64
CACHE_TTL_SECONDS=1800
CACHE_DIR=.model_cache
PREVIEW_ITERS=4
PREVIEW_MIN_F1=0.60
PREVIEW_MIN_LIFT=0.10
PREVIEW_MIN_POS_CONF=0.70
PREVIEW_MAX_NEG_CONF=0.30
PREVIEW_MAX_FPR=0.20

RANDOM_SEED=42
EPOCHS_TEXTCAT=10
EPOCHS_NER=8
BATCH_SIZE=16
EARLY_STOP_PATIENCE=3
WORK_DIR=/tmp/trainer-work

# (opcional mas recomendado p/ determinismo do preview)
PREVIEW_FORCE_CPU=true